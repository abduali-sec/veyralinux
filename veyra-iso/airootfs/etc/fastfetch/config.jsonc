{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "data-raw",
        "source": "██╗   ██╗███████╗██╗   ██╗██████╗  █████╗\n██║   ██║██╔════╝╚██╗ ██╔╝██╔══██╗██╔══██╗\n██║   ██║█████╗   ╚████╔╝ ██████╔╝███████║\n╚██╗ ██╔╝██╔══╝    ╚██╔╝  ██╔══██╗██╔══██║\n ╚████╔╝ ███████╗   ██║   ██║  ██║██║  ██║\n  ╚═══╝  ╚══════╝   ╚═╝   ╚═╝  ╚═╝╚═╝  ╚═╝",
        "padding": {
            "right": 3
        }
    },

    "display": {
        "separator": " : "
    },

    "modules": [
        "title",
        "separator",

        {
            "type": "custom",
            "format": "OS          : Veyra Linux"
        },
        {
            "type": "custom",
            "format": "Version     : 0.1.0 Genesis"
        },

        "kernel",
        "uptime",
        "packages",
        "shell",
        "terminal",
        "display",
        "de",
        "wm",
        "cpu",
        "gpu",
        "memory",

        {
            "type": "disk",
            "folders": ["/"]
        },

        "localip",

        "break",

        {
            "type": "custom",
            "format": "Package Mgr : vpm"
        },
        {
            "type": "custom",
            "format": "Repository  : Veyra Repository"
        },
        {
            "type": "custom",
            "format": "Codename    : Genesis"
        },
        {
            "type": "custom",
            "format": "Made        : Abduali"
        }
    ]
}
