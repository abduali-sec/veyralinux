#!/bin/bash

set -u

while true; do
    CHOICE=$(kdialog \
        --title "Veyra Center" \
        --menu "Veyra Linux — Control Center" \
        settings "Veyra Settings" \
        info "System Information" \
        packages "Veyra Packages" \
        updates "Veyra Updates" power "Power Management" firewall "Veyra Firewall" \
        doctor "Veyra Doctor" \
        disks "Storage & Disks" hardware "Hardware Information" audio "Audio" print "Printing & Scanning" \
        installer "Veyra Installer" \
        welcome "Veyra Welcome" \
        about "About Veyra" \
        terminal "Veyra Terminal" \
        quit "Close")

    [ "$?" -eq 0 ] || exit 0

    case "$CHOICE" in
        settings)
            exec /usr/bin/veyra-settings
            ;;

        info)
            konsole -e /usr/bin/veyra-info
            ;;

        packages)
            konsole -e /usr/bin/vpm
            ;;

        updates)
            konsole -e /usr/bin/veyra-update
            ;;

        doctor)
            konsole -e /usr/bin/veyra-doctor
            ;;

        disks)
            konsole -e /usr/bin/veyra-disks
            ;;


        hardware)
            exec veyra-hardware
            ;;

        audio)
            konsole -e /usr/bin/veyra-audio
            ;;

        print)
            exec veyra-print
            ;;
        installer)
            exec /usr/bin/veyra-installer
            ;;

        welcome)
            exec /usr/bin/veyra-welcome
            ;;

        about)
            konsole -e /usr/bin/veyra-about
            ;;

        terminal)
            exec konsole
            ;;

        quit)
            exit 0
            ;;
    esac
done
