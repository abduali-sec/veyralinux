#!/bin/bash

clear

echo "========================================"
echo "              VEYRA LINUX"
echo "========================================"
echo
echo "System"
echo "------"
echo "OS           : Veyra Linux"
echo "Version      : ${VEYRA_VERSION:-0.1.0}"
echo "Codename     : ${VEYRA_CODENAME:-Genesis}"
echo "Architecture : $(uname -m)"
echo "Kernel       : $(uname -r)"
echo "Hostname     : $(hostname)"
echo

if command -v fastfetch >/dev/null 2>&1; then
    fastfetch --config /etc/fastfetch/config.jsonc
fi
